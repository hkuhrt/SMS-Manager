# Die Web-App lauscht ausschließlich lokal.
APP_HOST=127.0.0.1
APP_PORT=4173

# Automatische Updates aus stabilen GitHub-Releases. Mit false vollständig deaktivierbar.
AUTO_UPDATE=true

# Aktuelle MEDICAL-OFFICE-Installation (MariaDB).
DB_KIND=mariadb
DB_HOST=127.0.0.1
DB_PORT=2020
DB_NAME=medoff
DB_USER=smsreminder_reader
DB_PASSWORD=BITTE_EIN_SICHERES_PASSWORT_SETZEN
DB_CLIENT_PATH=C:\MEDOFF\mariadb\bin\mysql.exe

# Getrennte Freigaben in MEDICAL OFFICE. Die Marker müssen dort exakt so angelegt sein.
# Bestehende SMS-Einwilligungen bleiben damit auf den SMS-Kanal beschränkt.
SMS_CONSENT_MARKER_TEXT=SMS-Erinnerung erlaubt
RCS_CONSENT_MARKER_TEXT=RCS-Erinnerung mit SMS-Fallback erlaubt

# Lokale MEDICAL-OFFICE-Übergabe. Die Schlüsseldatei wird beim ersten Start erzeugt.
MO_AKTPAT_PATH=C:\MEDOFF\AKTPAT.TXT
MO_INTEGRATION_KEY_FILE=C:\ProgramData\PraxisRecker\SMSReminder\data\medical-office-integration.key
MO_SELECTION_TTL_SECONDS=300
MO_SOURCE_FRESHNESS_SECONDS=30

# Lokale Historie. Für den sicheren Einstieg bleibt der Testmodus aktiv.
DATA_DIR=C:\ProgramData\PraxisRecker\SMSReminder\data
HISTORY_RETENTION_DAYS=90
MESSAGE_MODE=mock

# Für den Echtbetrieb nach Freigabe des RCS-Agenten: MESSAGE_MODE=seven
# Den Schlüssel mit den minimal nötigen Scopes rcs, sms und journal anlegen.
SEVEN_API_KEY=
SEVEN_RCS_AGENT_ID=
SEVEN_SMS_SENDER=Praxis
SEVEN_REQUEST_TIMEOUT_MS=10000
SEVEN_RCS_TTL_MINUTES=60
SEVEN_STATUS_SYNC_MINUTES=5

# Maximale Zeitspanne und Ergebnismenge je Abfrage.
MAX_RANGE_DAYS=31
MAX_APPOINTMENTS=500
SINGLE_PATIENT_LOOKAHEAD_DAYS=365
MAX_BATCH_SIZE=100

