# Die Web-App lauscht ausschließlich lokal.
APP_HOST=127.0.0.1
APP_PORT=4173

# Aktuelle MEDICAL-OFFICE-Installation (MariaDB).
DB_KIND=mariadb
DB_HOST=127.0.0.1
DB_PORT=2020
DB_NAME=medoff
DB_USER=smsreminder_reader
DB_PASSWORD=BITTE_EIN_SICHERES_PASSWORT_SETZEN
DB_CLIENT_PATH=C:\MEDOFF\mariadb\bin\mysql.exe

# SMS-Freigabe in MEDICAL OFFICE. Der Marker muss dort exakt so angelegt sein.
CONSENT_MARKER_TEXT=SMS-Erinnerung erlaubt

# Lokale MEDICAL-OFFICE-Übergabe. Die Schlüsseldatei wird beim ersten Start erzeugt.
MO_AKTPAT_PATH=C:\MEDOFF\AKTPAT.TXT
MO_INTEGRATION_KEY_FILE=C:\ProgramData\PraxisRecker\SMSReminder\data\medical-office-integration.key
MO_SELECTION_TTL_SECONDS=300
MO_SOURCE_FRESHNESS_SECONDS=30

# Lokale Historie und bewusst gesperrter Testmodus.
DATA_DIR=C:\ProgramData\PraxisRecker\SMSReminder\data
HISTORY_RETENTION_DAYS=90
SMS_MODE=mock

# Maximale Zeitspanne und Ergebnismenge je Abfrage.
MAX_RANGE_DAYS=31
MAX_APPOINTMENTS=500
SINGLE_PATIENT_LOOKAHEAD_DAYS=365
MAX_BATCH_SIZE=100

